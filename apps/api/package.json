{
  "name": "@ai-qa/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node --env-file=../../.env ../../packages/database/node_modules/prisma/build/index.js generate --schema ../../packages/database/prisma/schema.prisma",
    "prisma:push": "node --env-file=../../.env ../../packages/database/node_modules/prisma/build/index.js db push --schema ../../packages/database/prisma/schema.prisma",
    "prisma:migrate:dev": "node --env-file=../../.env ../../packages/database/node_modules/prisma/build/index.js migrate dev --schema ../../packages/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "node --env-file=../../.env ../../packages/database/node_modules/prisma/build/index.js migrate deploy --schema ../../packages/database/prisma/schema.prisma",
    "prisma:migrate:status": "node --env-file=../../.env ../../packages/database/node_modules/prisma/build/index.js migrate status --schema ../../packages/database/prisma/schema.prisma",
    "prisma:migrate:reset": "node --env-file=../../.env ../../packages/database/node_modules/prisma/build/index.js migrate reset --schema ../../packages/database/prisma/schema.prisma",
    "prisma:validate": "node --env-file=../../.env ../../packages/database/node_modules/prisma/build/index.js validate --schema ../../packages/database/prisma/schema.prisma",
    "prisma:format": "node --env-file=../../.env ../../packages/database/node_modules/prisma/build/index.js format --schema ../../packages/database/prisma/schema.prisma",
    "prisma:studio": "node --env-file=../../.env ../../packages/database/node_modules/prisma/build/index.js studio --schema ../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@ai-qa/contracts": "workspace:*",
    "@ai-qa/domain": "workspace:*",
    "@ai-qa/model-provider": "workspace:*",
    "@ai-qa/test-dsl": "workspace:*",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.1",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.8",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^7.0.9",
    "playwright": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^23.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
