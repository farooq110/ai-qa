# Public origin of this marketing site (used for canonical URLs, sitemap, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Customer dashboard origin (apps/web). Signup/sign-in links point here.
NEXT_PUBLIC_APP_URL=http://localhost:3004
# Control plane API, called server-to-server to persist support queries.
API_URL=http://localhost:4000
# Same API, reachable from the browser — used by the contact modal to request a presigned S3 upload URL directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Gmail account used to send/receive support modal emails. Use an App Password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Inbox that receives support submissions. Defaults to GMAIL_USER if unset.
SUPPORT_INBOX_EMAIL=
