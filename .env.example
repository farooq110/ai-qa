DATABASE_URL="postgresql://proofline:proofline@localhost:5433/proofline?schema=public"
REDIS_URL="redis://localhost:6380"
JWT_SECRET="replace-this-with-a-long-random-secret"
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
SUPERADMIN_PASSWORD="replace-with-a-strong-password"
ARTIFACT_DIR="./artifacts"
# Public base URL of this API — providers deliver CI webhooks here. Locally, run
# `cloudflared tunnel --url http://localhost:4000` and paste the https URL it prints.
PUBLIC_API_URL="https://occasions-routine-survival-handles.trycloudflare.com"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL=""
# Repository providers: the platform owns one app per provider; customers only click Connect.
# GitHub App (github.com/settings/apps/new): Callback URL = GITHUB_CALLBACK_URL, enable
# "Request user authorization (OAuth) during installation". Permissions: Contents read,
# Metadata read, Deployments read, Actions read, Checks write, Commit statuses write, Pull requests read.
# Webhook: active, URL = {PUBLIC_API_URL}/v1/webhooks/github, secret = GITHUB_APP_WEBHOOK_SECRET,
# events: Deployment status, Workflow run. Paste the private
# key PEM on one line with \n escapes.
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/v1/repository-connections/github/callback"
# Bitbucket OAuth consumer (Workspace settings → OAuth consumers): callback = BITBUCKET_CALLBACK_URL,
# permissions Account read, Repositories read, Pull requests read, Webhooks read and write.
BITBUCKET_CLIENT_ID=""
BITBUCKET_CLIENT_SECRET=""
BITBUCKET_CALLBACK_URL="http://localhost:4000/v1/repository-connections/bitbucket/callback"
# gitlab.com application (User settings → Applications): redirect = GITLAB_CALLBACK_URL, scope api.
# Self-managed GitLab instances register their own application in Settings → Repository providers.
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GITLAB_CALLBACK_URL="http://localhost:4000/v1/repository-connections/gitlab/callback"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Web app base URL: Stripe Checkout/Portal returns and links in auth emails
WEB_APP_URL="http://localhost:3004"
PLAYWRIGHT_WORKER_CONCURRENCY=2
PLAYWRIGHT_STEP_TIMEOUT_MS=8000

# AWS S3 CONFIG
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=agentic-qa-proofline-dev
AWS_S3_REGION=us-east-1
# SMTP CONFIGURATION
SMTP_USER=support@prooflineqa.com
SMTP_PASSWORD=wour-vijo-mlu1-pewx
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Inbox that receives support submissions. Defaults to SMTP_USER if unset.
SUPPORT_INBOX_EMAIL=support@prooflineqa.com
# Recorder desktop installers (Electron). Local dev serves them from apps/recorder/dist;
# production: set to /data/installers (bind-mounted from /opt/agentic-qa/installers on the VPS).
# RECORDER_INSTALLER_DIR=/data/installers
